# Variables de docker-compose.prod.yml. En la VM: cp .env.example .env y llenar los valores.
# .env no se sube al repositorio (.gitignore).

# Dominio del backend, para el HTTPS de Caddy. Sin dominio propio: la IP de la VM con guiones + .sslip.io
DOMAIN=20-30-40-50.sslip.io
# Cómo encuentran el broker los Módulos 1 y 3: la IP pública de la VM o un dominio que apunte a ella
KAFKA_PUBLIC_HOST=20.30.40.50

POSTGRES_PASSWORD=cambiar-por-una-contraseña-larga
# Al menos 32 caracteres: openssl rand -base64 48
JWT_SECRET=

# APIs REST de los otros módulos
MODULE1_BASE_URL=http://modulo1.ejemplo:8081
MODULE3_BASE_URL=http://modulo3.ejemplo:8083
# HTTP Basic de la API del Módulo 1 (nos lo dan ellos)
MODULE1_USERNAME=
MODULE1_PASSWORD=
# Sus servidores en Render gratis se duermen: con 5s y 1500ms el primer pedido tras la siesta falla
MODULE1_TIMEOUT=5s
MODULE3_TIMEOUT=1500ms

# true para publicar /swagger-ui
SWAGGER_ENABLED=false
